{
  "name": "branching-table-of-contents",
  "version": "0.1.1",
  "description": "Link notes with parent/child properties and see them as a clean, rooted family tree of the current note instead of the tangled graph view.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "make-sample-vault": "node scripts/make-sample-vault.mjs",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "table-of-contents",
    "tree",
    "hierarchy",
    "graph"
  ],
  "author": "Tony Peonio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "jsdom": "^26.1.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
