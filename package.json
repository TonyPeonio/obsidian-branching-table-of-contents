{
  "name": "branching-table-of-contents",
  "version": "0.3.0",
  "description": "Link notes with parent/child properties and see them as a clean, rooted family tree of the current note instead of the tangled graph view.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json manifest-beta.json",
    "make-sample-vault": "node scripts/make-sample-vault.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -noEmit -skipLibCheck && tsc -p e2e",
    "bench": "vitest run --config vitest.bench.config.mts",
    "e2e:obsidian": "npm run build && wdio run ./wdio.conf.mts",
    "beta": "node scripts/beta.mjs"
  },
  "keywords": [
    "obsidian",
    "table-of-contents",
    "tree",
    "hierarchy",
    "graph"
  ],
  "author": "Tony Peonio",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "jsdom": "^26.1.0",
    "mocha": "^12.0.3",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0",
    "webdriverio": "^9.32.0"
  }
}
